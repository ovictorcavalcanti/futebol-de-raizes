# Futebol de Raízes — variáveis de ambiente (lidas por config/settings.py).
#
# Uso: copie para `.env` e ajuste. O scripts/run_dev.sh carrega o `.env` no
# shell; o docker-compose.yml o repassa ao contêiner `app`. Valores com espaço
# vão entre aspas duplas. Linhas comentadas mostram o padrão.

# --- Django -------------------------------------------------------------------
# Chave secreta: assina sessão, CSRF e redefinição de senha. Este exemplo só serve
# com DJANGO_DEBUG=1: com DEBUG=0 (compose, imagem Docker) o servidor se recusa a
# subir com ele, com a chave padrão do código ou com qualquer chave fraca (menos
# de 50 caracteres). O docker-compose.yml exige a variável. Gere uma com:
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# 1 em desenvolvimento; 0 no ambiente de teste/produção (o compose e a imagem
# Docker forçam 0).
DJANGO_DEBUG=1
# Hosts aceitos. Mantenha 127.0.0.1: o healthcheck do contêiner usa esse endereço.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# Origens confiáveis para o CSRF (esquema + host [+ porta]).
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,http://localhost:8000
# Cookies só por HTTPS. Padrão: o contrário de DJANGO_DEBUG (o compose força 1).
# SECURE_COOKIES=0
# HSTS (segundos) e redirecionamento para HTTPS no próprio Django. Padrão: desligados
# (no compose o Caddy já redireciona; HSTS com a CA interna de teste atrapalha). Em
# produção com certificado público: SECURE_HSTS_SECONDS=31536000.
# SECURE_HSTS_SECONDS=0
# SECURE_SSL_REDIRECT=0
# Fuso do "dia", do relógio e dos horários exibidos (horário de Brasília).
APP_TIME_ZONE=America/Sao_Paulo
# Armazenamento dos estáticos. Padrão: simples com DEBUG=1; com DEBUG=0,
# manifesto com hash no nome (cache longo e imutável) e versões .gz/.br já
# comprimidas, que exige collectstatic.
# STATICFILES_BACKEND=core.storage.ModuleManifestStaticFilesStorage

# --- Banco (PostgreSQL 16) ----------------------------------------------------
DB_NAME=fdr
DB_USER=postgres
# "postgres" é a senha do contêiner db do compose (vazio também vira "postgres"
# lá dentro); um Postgres local com autenticação trust ignora a senha.
DB_PASSWORD=postgres
# localhost no desenvolvimento; o compose força "db" (e a porta 5432) no app.
DB_HOST=localhost
DB_PORT=5432
# Banco dos testes (pytest). Use um por pessoa/agente para rodar em paralelo.
# O pytest não lê este arquivo: use as variáveis do shell (ex.: com o banco do
# compose, DB_PASSWORD=postgres TEST_DB_NAME=test_fdr_seu_nome pytest).
TEST_DB_NAME=test_fdr
# Pool de conexões do psycopg (Django 5.1+): recomendado no processo ASGI (sem ele
# cada requisição abre e fecha uma conexão). O compose liga por padrão; o código,
# sem esta variável, deixa desligado. O hub do tempo real segura uma conexão do
# pool o tempo todo: mantenha DB_POOL_MAX >= 3 (e abaixo do max_connections).
DB_POOL=1
DB_POOL_MIN=2
DB_POOL_MAX=20
# PostgreSQL do compose para desenvolver no host, sem Postgres local:
#   scripts/dev_db.sh   (docker compose -f docker-compose.yml -f deploy/compose.dev.yml up -d db)
# publica o banco em 127.0.0.1:DB_PUBLISH_PORT; com a 5432 ocupada, use outra
# porta aqui e a mesma em DB_PORT.
# DB_PUBLISH_PORT=5432

# --- Marca (logo e identidade) --------------------------------------------------
# Troque a marca sem mexer no código. Logos aceitam caminho estático
# ("img/logo.svg", dentro de static/) ou URL absoluta (https://...).
BRAND_NAME="Futebol de Raízes"
BRAND_SHORT_NAME=Raízes
BRAND_TAGLINE="O futebol pernambucano, lance a lance"
BRAND_LOGO_URL=img/logo.svg
# Logo do tema escuro; vazio = usa o mesmo do tema claro.
BRAND_LOGO_DARK_URL=
BRAND_LOGO_ALT="Futebol de Raízes"
BRAND_FAVICON_URL=img/favicon.svg
# Cor da barra do navegador no celular (meta theme-color).
BRAND_THEME_COLOR="#12306B"

# --- Tempo real (stream SSE e outbox) ---------------------------------------------
# Segundos entre pings do stream (mantém a conexão e acerta o relógio).
REALTIME_PING_INTERVAL=20
# Polling de segurança do hub, em segundos (o aviso do commit já acorda o hub;
# o polling pega escritas feitas por outros processos, como scripts).
REALTIME_POLL_INTERVAL=2
# Horas que as mensagens ficam no outbox para reenvio na reconexão.
OUTBOX_RETENTION_HOURS=24
# Lotes pendentes por conexão; quem passa disso é desconectado e volta com
# Last-Event-ID, recebendo o que perdeu.
REALTIME_QUEUE_SIZE=1000
# 0 desliga o hub: cada conexão consulta o banco sozinha (só para depuração).
REALTIME_HUB_ENABLED=1

# --- Observabilidade ----------------------------------------------------------
# Token para GET /metrics (header "Authorization: Bearer <token>"). Vazio: só
# usuário logado com a permissão observability.view_metrics.
METRICS_TOKEN=
LOG_LEVEL=INFO
# json (uma linha por registro) ou plain.
LOG_FORMAT=json

# --- Leituras (GET /api/home e /api/competitions/{slug}) ---------------------------
# Micro-cache em memória, em segundos, chaveado pelo cursor do outbox (toda escrita
# que publica mensagem invalida na hora). Edição no admin que não publica nada (nome
# de time/competição, escudo) aparece em até este tempo. 0 desliga.
READ_CACHE_SECONDS=5

# --- API pública (/public/v1) ---------------------------------------------------
PUBLIC_API_RATE_LIMIT=60
PUBLIC_API_CACHE_MAX_AGE=10

# --- Só docker-compose (não lidas pelo Django) ------------------------------------
# Endereço servido pelo Caddy (deploy/Caddyfile), com HTTPS da CA interna.
# Ao trocar, inclua o host em DJANGO_ALLOWED_HOSTS e https://<host> em
# DJANGO_CSRF_TRUSTED_ORIGINS.
# Só o host, sem porta (a porta publicada é HTTPS_PORT).
SITE_ADDRESS=localhost
# Portas publicadas pelo proxy. Com HTTPS_PORT diferente de 443, acesse
# https://<host>:<HTTPS_PORT> direto (o redirecionamento de http:// aponta para a 443).
HTTP_PORT=80
HTTPS_PORT=443

# --- Limites de acesso (proteção contra força bruta e enxurrada) ---------------
# Bloqueio progressivo de login (API e Django Admin), por usuário + IP e por IP.
LOGIN_THROTTLE_ENABLED=1
# falhas seguidas por usuário + IP até bloquear
LOGIN_THROTTLE_USER_FAILURES=5
# 1º bloqueio em segundos; dobra a cada novo
LOGIN_THROTTLE_BASE_LOCK=60
# teto do bloqueio (s)
LOGIN_THROTTLE_MAX_LOCK=900
# por quanto tempo os bloqueios anteriores contam (s)
LOGIN_THROTTLE_STRIKE_MEMORY=86400
# falhas de um IP, com qualquer usuário...
LOGIN_THROTTLE_IP_FAILURES=20
# ...nesta janela (s)...
LOGIN_THROTTLE_IP_WINDOW=900
# ...bloqueiam o IP por este tempo (s)
LOGIN_THROTTLE_IP_LOCK=900
# Requisições por IP por minuto nas rotas /api/ (0 desliga).
API_RATE_LIMIT_PER_MINUTE=240
# Conexões ao vivo (SSE) abertas por IP e no processo inteiro.
REALTIME_MAX_STREAMS_PER_IP=20
REALTIME_MAX_STREAMS=5000
# Corpo máximo de requisição, em bytes.
DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
